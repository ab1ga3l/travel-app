# Copy to .env.local and fill in what you have. Everything is optional: the app runs
# without keys and each feature switches on when its key is added. Never commit real keys.

NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Aviora, the AI assistant (https://platform.claude.com)
ANTHROPIC_API_KEY=
AGENT_DAILY_LIMIT=5

# Accounts, trip sync, community, gem verdicts (https://supabase.com, run supabase/schema.sql)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: visa stories and newsletter. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional paid application review (e.g. a Stripe Payment Link)
NEXT_PUBLIC_REVIEW_URL=

# Partner / affiliate links (empty = shown as "coming soon")
NEXT_PUBLIC_AFF_HOTELS_URL=
NEXT_PUBLIC_AFF_FLIGHTS_URL=
NEXT_PUBLIC_AFF_RIDES_URL=
NEXT_PUBLIC_AFF_ESIM_URL=
NEXT_PUBLIC_AFF_INSURANCE_URL=
NEXT_PUBLIC_AFF_TOURS_URL=
