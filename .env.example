# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (used for sitemap and links)
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com
NEXT_PUBLIC_CONTACT_EMAIL=

# AI agent (Ama) — get a key at https://platform.claude.com
ANTHROPIC_API_KEY=
# Free questions per visitor per day
AGENT_DAILY_LIMIT=5

# Community stories + newsletter (https://supabase.com, run supabase/schema.sql first)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: create Stripe Payment Links and paste them here
NEXT_PUBLIC_STRIPE_VISA_READY_URL=
NEXT_PUBLIC_STRIPE_REVIEW_URL=

# Affiliate links (leave empty to hide an offer)
NEXT_PUBLIC_AFF_INSURANCE_URL=
NEXT_PUBLIC_AFF_ESIM_URL=
NEXT_PUBLIC_AFF_HOTELS_URL=
NEXT_PUBLIC_AFF_TOURS_URL=
NEXT_PUBLIC_AFF_FLIGHTS_URL=
