# Copy to .env and fill in what you have. Everything is optional: the app runs on the phone
# without keys, and each feature switches on when its key is added. Never commit real keys.

# Accounts, group trips, votes, community (same Supabase project as the website)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The website's address, for Aviora and "describe your trip" (e.g. https://tokende.vercel.app)
EXPO_PUBLIC_API_URL=
